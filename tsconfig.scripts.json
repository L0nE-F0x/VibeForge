{
  // scripts/*.mjs, checked as JavaScript. talk.mjs joins once the window-security changes to it land.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/*.mjs"],
  "exclude": ["scripts/talk.mjs"]
}
