<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/scan_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC09090B"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:padding="20dp"
        android:text="@string/scan_title"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/scan_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC09090B"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text="@string/scan_hint"
            android:textColor="#A1A1AA"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/btn_scan_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#27272A"
            android:fontFamily="monospace"
            android:paddingVertical="12dp"
            android:text="@string/scan_cancel"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
