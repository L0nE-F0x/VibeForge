<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <!-- Row 1: VibeForge + Status Pill + Main Buttons + Expand Chevron -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/header_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_vibeforge_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="VIBEFORGE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_quiet"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="SYNC"
                android:textColor="#A1A1AA"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_viby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn"
            android:fontFamily="monospace"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="VIBY"
            android:textColor="#E4E4E7"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn"
            android:fontFamily="monospace"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="↻"
            android:textColor="#FCA311"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn"
            android:fontFamily="monospace"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:text="⚙"
            android:textColor="#A1A1AA"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toggle_btn"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/icon_toggle"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Expand dashboard tray"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Basic At-a-Glance Info Strip -->
    <LinearLayout
        android:id="@+id/bar_info_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bar_summary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Tap ▾ for sessions &amp; limits"
            android:textColor="#A1A1AA"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/bar_meta_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#71717A"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Shown only when the launcher host slot is still oversized (3+ rows from v1.0) -->
    <TextView
        android:id="@+id/oversize_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_btn"
        android:fontFamily="monospace"
        android:paddingHorizontal="7dp"
        android:paddingVertical="4dp"
        android:text="Grid slot is 3+ rows tall — resize to 1 row (4×1) or remove &amp; re-add so apps fit underneath"
        android:textColor="#FCA311"
        android:textSize="9.5sp"
        android:visibility="gone" />

</LinearLayout>
