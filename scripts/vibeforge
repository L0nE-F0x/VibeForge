#!/usr/bin/env bash
# Open the built VibeForge window. The app launcher entry runs this.
#
# A git checkout builds first when its code is newer than the last build, so
# `vibeforge` opens the code on this computer. An installer copy (the
# `.vibeforge-installer` mark) still updates through the installer.
# VIBEFORGE_SKIP_BUILD=1 opens the last build without rebuilding.
# VIBEFORGE_LAUNCH=check prints "build", "current", or "already-running" and exits.
# `vibeforge --rollback`, `--uninstall` and `--purge-app` run the installer (scripts/install.sh).
#
# Started from the app launcher or at login (no terminal to show errors in), Electron's output goes
# to ~/.cache/vibeforge/launch.log, and an Electron that is gone five seconds later with no
# VibeForge open is reported with a desktop notification naming the last lines it wrote.
set -euo pipefail

# The real folder, never a link: an installer copy is versions/<version>/ in the install folder,
# reached through its `current` link, and a running copy must keep its own files when that link
# moves to the next version.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
# The install folder the installer manages: the one above versions/, or this copy itself.
INSTALL_ROOT="$ROOT"
if [[ "$(basename "$(dirname "$ROOT")")" == versions && -e "$(dirname "$(dirname "$ROOT")")/.vibeforge-installer" ]]; then
  INSTALL_ROOT="$(dirname "$(dirname "$ROOT")")"
fi
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH:-/usr/bin:/bin}"
ELECTRON="$ROOT/node_modules/electron/dist/electron"

# Node for the launcher's own small scripts: the system's when there is one (it starts quickest),
# else Electron's own, started as plain Node. VibeForge itself needs no system Node.
if command -v node >/dev/null 2>&1; then
  NODE=(node)
else
  NODE=(env ELECTRON_RUN_AS_NODE=1 "$ELECTRON")
fi

# The path matches src/core/control.ts. One socket per data folder. Without XDG_RUNTIME_DIR it sits
# in a /tmp folder only this user can enter; when someone else made that folder, there's no path.
control_sock() {
  local data tag dir
  data="${VIBEFORGE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/vibeforge}"
  tag="$(printf %s "$data" | sha1sum | cut -c1-8)"
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    dir="$XDG_RUNTIME_DIR"
  else
    dir="/tmp/vibeforge-$(id -u)"
    mkdir -m 700 "$dir" 2>/dev/null || true
    if [[ -L "$dir" || ! -d "$dir" || ! -O "$dir" ]]; then
      echo "vibeforge: $dir isn't yours, so its control socket isn't used" >&2
      return 0
    fi
    [[ "$(stat -c %a "$dir")" == 700 ]] || chmod 700 "$dir"
  fi
  printf '%s\n' "$dir/vibeforge-$tag.sock"
}

# `vibeforge tell|who|task|apply …`, from a coding CLI in a VibeForge terminal: talk to the other CLIs
# through the running window. scripts/talk.mjs has the details (`vibeforge help`). Every command it
# takes is listed here: one that isn't would start a second window, which quits at once
# (tests/unit/launcher.test.ts checks).
case "${1:-}" in
  tell | who | task | apply | help | --help | -h)
    [[ "${NODE[0]}" == node || -x "$ELECTRON" ]] || { echo "vibeforge: neither node nor VibeForge's Electron was found" >&2; exit 1; }
    VIBEFORGE_SOCKET="${VIBEFORGE_SOCKET:-$(control_sock)}" exec "${NODE[@]}" "$ROOT/scripts/talk.mjs" "$@"
    ;;
esac

# The installer's own options, for an installed copy: going back to the version before, or removing
# VibeForge. Its install.sh is in every copy.
case "${1:-}" in
  --rollback | --uninstall | --purge-app)
    [[ -f "$ROOT/scripts/install.sh" ]] || { echo "vibeforge: $ROOT has no scripts/install.sh" >&2; exit 1; }
    if [[ -e "$ROOT/.vibeforge-installer" ]]; then
      VIBEFORGE_HOME="$INSTALL_ROOT" exec bash "$ROOT/scripts/install.sh" "$1"
    fi
    exec bash "$ROOT/scripts/install.sh" "$1"
    ;;
esac

# `vibeforge --voice start|stop|cancel`, from a keybinding: hand the action to the
# running window over its control socket, which takes milliseconds, where starting Electron to be
# handed off would lose the first words.
if [[ "${1:-}" == --voice* ]]; then
  action="${1#--voice}"
  action="${action#=}"
  [[ -z "$action" ]] && action="${2:-start}"
  sock="$(control_sock)"
  if [[ -S "$sock" ]]; then
    if command -v socat >/dev/null 2>&1; then
      printf 'voice %s\n' "$action" | socat - "UNIX-CONNECT:$sock" 2>/dev/null && exit 0
    else
      "${NODE[@]}" -e 'const s=require("net").connect(process.argv[1]);s.on("error",()=>process.exit(1));s.end("voice "+process.argv[2]+"\n")' "$sock" "$action" 2>/dev/null && exit 0
    fi
  fi
  # Not running: a press opens VibeForge; a release has nothing to stop.
  case "$action" in stop|cancel) exit 0 ;; esac
  set -- --voice "$action"
fi

fail() {
  echo "VibeForge: $1" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send -a VibeForge "VibeForge can't start" "$1" || true
  exit 1
}

note() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a VibeForge "VibeForge" "$1" || true
}

# How to put a missing part back: an installer copy has no source to build, so it installs again.
put_back() {
  if [[ -e "$ROOT/.vibeforge-installer" ]]; then
    printf 'Install VibeForge again: curl -fsSL https://vibe-forge.net/install | VIBEFORGE_HOME=%q bash' "$INSTALL_ROOT"
  else
    printf 'In %s run: %s' "$ROOT" "$1"
  fi
}

[[ -x "$ELECTRON" ]] || fail "Electron is missing. $(put_back "npm install")"

# A connect with no line is ignored by the control server. A stale socket file fails the connect.
app_is_running() {
  local sock
  sock="$(control_sock)"
  [[ -S "$sock" ]] || return 1
  "${NODE[@]}" -e 'const s=require("net").connect(process.argv[1]); s.setTimeout(300); s.on("connect",()=>{s.end(); process.exit(0)}); s.on("timeout",()=>process.exit(1)); s.on("error",()=>process.exit(1));' "$sock"
}

# True when this checkout should rebuild itself. Installer copies and
# VIBEFORGE_SKIP_BUILD=1 never do.
checkout_tracks_source() {
  [[ "${VIBEFORGE_SKIP_BUILD:-}" == "1" ]] && return 1
  [[ -e "$ROOT/.vibeforge-installer" ]] && return 1
  git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# True when dist is missing or older than the files the production build reads.
# The launcher script is not one of them: editing it takes effect on the next start.
source_is_newer() {
  local built ui newest newest_s
  [[ -f "$ROOT/dist/index.html" && -f "$ROOT/dist-electron/main.js" ]] || return 0
  built="$(stat -c %Y "$ROOT/dist-electron/main.js")"
  ui="$(stat -c %Y "$ROOT/dist/index.html")"
  (( ui < built )) && built="$ui"
  newest="$(
    find \
      "$ROOT/src" "$ROOT/electron" "$ROOT/resources" \
      "$ROOT/package.json" "$ROOT/package-lock.json" \
      "$ROOT/vite.config.mts" "$ROOT/tsconfig.json" "$ROOT/tsconfig.node.json" \
      "$ROOT/index.html" \
      -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1 || true
  )"
  [[ -n "$newest" ]] || return 1
  newest_s="${newest%%.*}"
  (( newest_s > built ))
}

needs_build() {
  checkout_tracks_source || return 1
  source_is_newer
}

if [[ "${VIBEFORGE_LAUNCH:-}" == "check" ]]; then
  if app_is_running; then
    echo already-running
  elif needs_build; then
    echo build
  else
    echo current
  fi
  exit 0
fi

if needs_build; then
  if app_is_running; then
    # The open window already loaded its code. Rewriting dist under it would
    # not change that window, and a half-written build could break the next one.
    note "VibeForge is already open. Quit it, then start it again to load the latest code."
  else
    logdir="${XDG_CACHE_HOME:-$HOME/.cache}/vibeforge"
    mkdir -p "$logdir"
    note "Building the latest code, then opening."
    echo "VibeForge: building the latest code…" >&2
    if ! (cd "$ROOT" && if command -v npm >/dev/null 2>&1; then npm run build; else ./node_modules/.bin/vite build; fi) >"$logdir/launch-build.log" 2>&1; then
      echo "VibeForge: build failed. Last lines:" >&2
      tail -n 20 "$logdir/launch-build.log" >&2 || true
      fail "The build failed. See $logdir/launch-build.log"
    fi
  fi
fi

[[ -f "$ROOT/dist/index.html" && -f "$ROOT/dist-electron/main.js" ]] || fail "The app is not built. $(put_back "npm run build")"

cd "$ROOT"
# Through its link into the install folder's runtime/, to the binary itself.
electron="$(readlink -f "$ROOT/node_modules/electron/dist/electron")"

# From a terminal, Electron takes it over, as always: its errors show there.
if [[ -t 2 || "${VIBEFORGE_LAUNCH_WAIT:-}" == 0 ]]; then
  exec "$electron" "$ROOT" --class=vibeforge --enable-wayland-ime "$@"
fi

# From the app launcher or at login there is nowhere to see why a start failed. Electron still
# replaces this script, so whatever started VibeForge (the desktop, a systemd unit) keeps the same
# process, but its output goes to a log, and a watcher left behind looks after five seconds: if
# Electron is gone and no VibeForge is open (a second start hands over to the open window and
# exits), the start failed, and a notification says so with the last lines Electron wrote.
logdir="${XDG_CACHE_HOME:-$HOME/.cache}/vibeforge"
mkdir -p "$logdir" 2>/dev/null || logdir="${TMPDIR:-/tmp}"
log="$logdir/launch.log"
started=$$
( (
  for _ in $(seq "${VIBEFORGE_LAUNCH_WAIT:-50}"); do
    kill -0 "$started" 2>/dev/null || break
    sleep 0.1
  done
  kill -0 "$started" 2>/dev/null && exit 0
  app_is_running && exit 0
  last="$(grep -v -e '^[[:space:]]*$' -e '^VibeForge: ' "$log" 2>/dev/null | tail -n 3 | cut -c1-300 | tr '\n' ' ' || true)"
  why="It stopped as it started. ${last:+Last lines: $last}Full output: $log"
  printf 'VibeForge: %s\n' "$why" >>"$log"
  fail "$why"
) </dev/null >/dev/null 2>&1 & )
exec "$electron" "$ROOT" --class=vibeforge --enable-wayland-ime "$@" </dev/null >"$log" 2>&1
