#!/usr/bin/env bash
# Open the built VibeForge window. The app launcher entry runs this.
#
# A git checkout builds first when its code is newer than the last build, so
# `vibeforge` opens the code on this computer. An installer copy (the
# `.vibeforge-installer` mark) still updates through the installer.
# VIBEFORGE_SKIP_BUILD=1 opens the last build without rebuilding.
# VIBEFORGE_LAUNCH=check prints "build", "current", or "already-running" and exits.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# The path matches src/core/control.ts. One socket per data folder.
control_sock() {
  local data tag
  data="${VIBEFORGE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/vibeforge}"
  tag="$(printf %s "$data" | sha1sum | cut -c1-8)"
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    printf '%s\n' "$XDG_RUNTIME_DIR/vibeforge-$tag.sock"
  else
    printf '%s\n' "/tmp/vibeforge-$(id -u)-$tag.sock"
  fi
}

# `vibeforge --voice start|stop|cancel`, from a keybinding: hand the action to the
# running window over its control socket, which takes milliseconds, where starting Electron to be
# handed off would lose the first words.
if [[ "${1:-}" == --voice* ]]; then
  action="${1#--voice}"
  action="${action#=}"
  [[ -z "$action" ]] && action="${2:-start}"
  sock="$(control_sock)"
  if [[ -S "$sock" ]]; then
    if command -v socat >/dev/null 2>&1; then
      printf 'voice %s\n' "$action" | socat - "UNIX-CONNECT:$sock" 2>/dev/null && exit 0
    else
      node -e 'const s=require("net").connect(process.argv[1]);s.on("error",()=>process.exit(1));s.end("voice "+process.argv[2]+"\n")' "$sock" "$action" 2>/dev/null && exit 0
    fi
  fi
  # Not running: a press opens VibeForge; a release has nothing to stop.
  case "$action" in stop|cancel) exit 0 ;; esac
  set --
fi
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH:-/usr/bin:/bin}"

fail() {
  echo "VibeForge: $1" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send -a VibeForge "VibeForge can't start" "$1" || true
  exit 1
}

note() {
  command -v notify-send >/dev/null 2>&1 && notify-send -a VibeForge "VibeForge" "$1" || true
}

[[ -x "$ROOT/node_modules/electron/dist/electron" ]] || fail "Electron is missing. In $ROOT run: npm install"
command -v node >/dev/null 2>&1 || fail "node is not on PATH; the terminal host needs it."

# A connect with no line is ignored by the control server. A stale socket file fails the connect.
app_is_running() {
  local sock
  sock="$(control_sock)"
  [[ -S "$sock" ]] || return 1
  node -e 'const s=require("net").connect(process.argv[1]); s.setTimeout(300); s.on("connect",()=>{s.end(); process.exit(0)}); s.on("timeout",()=>process.exit(1)); s.on("error",()=>process.exit(1));' "$sock"
}

# True when this checkout should rebuild itself. Installer copies and
# VIBEFORGE_SKIP_BUILD=1 never do.
checkout_tracks_source() {
  [[ "${VIBEFORGE_SKIP_BUILD:-}" == "1" ]] && return 1
  [[ -e "$ROOT/.vibeforge-installer" ]] && return 1
  git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# True when dist is missing or older than the files the production build reads.
# The launcher script is not one of them: editing it takes effect on the next start.
source_is_newer() {
  local built ui newest newest_s
  [[ -f "$ROOT/dist/index.html" && -f "$ROOT/dist-electron/main.js" ]] || return 0
  built="$(stat -c %Y "$ROOT/dist-electron/main.js")"
  ui="$(stat -c %Y "$ROOT/dist/index.html")"
  (( ui < built )) && built="$ui"
  newest="$(
    find \
      "$ROOT/src" "$ROOT/electron" "$ROOT/resources" \
      "$ROOT/package.json" "$ROOT/package-lock.json" \
      "$ROOT/vite.config.ts" "$ROOT/tsconfig.json" "$ROOT/tsconfig.node.json" \
      "$ROOT/index.html" \
      -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1 || true
  )"
  [[ -n "$newest" ]] || return 1
  newest_s="${newest%%.*}"
  (( newest_s > built ))
}

needs_build() {
  checkout_tracks_source || return 1
  source_is_newer
}

if [[ "${VIBEFORGE_LAUNCH:-}" == "check" ]]; then
  if app_is_running; then
    echo already-running
  elif needs_build; then
    echo build
  else
    echo current
  fi
  exit 0
fi

if needs_build; then
  if app_is_running; then
    # The open window already loaded its code. Rewriting dist under it would
    # not change that window, and a half-written build could break the next one.
    note "VibeForge is already open. Quit it, then start it again to load the latest code."
  else
    logdir="${XDG_CACHE_HOME:-$HOME/.cache}/vibeforge"
    mkdir -p "$logdir"
    note "Building the latest code, then opening."
    echo "VibeForge: building the latest code…" >&2
    if ! (cd "$ROOT" && npm run build) >"$logdir/launch-build.log" 2>&1; then
      echo "VibeForge: build failed. Last lines:" >&2
      tail -n 20 "$logdir/launch-build.log" >&2 || true
      fail "The build failed. See $logdir/launch-build.log"
    fi
  fi
fi

[[ -f "$ROOT/dist/index.html" && -f "$ROOT/dist-electron/main.js" ]] || fail "The app is not built. In $ROOT run: npm run build"

cd "$ROOT"
exec "$ROOT/node_modules/electron/dist/electron" "$ROOT" --class=vibeforge --enable-wayland-ime "$@"
