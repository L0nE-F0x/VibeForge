{
  "name": "vibeforge",
  "version": "2.14.0",
  "private": true,
  "description": "VibeForge: an open-source desktop for Omarchy that runs Claude Code, Codex, Grok and the other coding CLIs you already use, side by side in real terminals, with agents, routines, tasks and Maestro.",
  "author": "Lone Fox (https://github.com/L0nE-F0x)",
  "license": "MIT",
  "homepage": "https://github.com/L0nE-F0x/VibeForge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L0nE-F0x/VibeForge.git"
  },
  "bugs": {
    "url": "https://github.com/L0nE-F0x/VibeForge/issues"
  },
  "keywords": [
    "omarchy",
    "hyprland",
    "arch-linux",
    "electron",
    "terminal",
    "claude-code",
    "codex",
    "grok",
    "ai-agents",
    "coding-agents"
  ],
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.19 <21 || >=22.12"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "biome lint",
    "postinstall": "node scripts/ensure-electron.cjs",
    "smoke": "node scripts/smoke.mjs",
    "release-notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.10.4",
    "cronstrue": "^3.38.0",
    "electron": "^45.2.1",
    "lucide-react": "^1.70.0",
    "node-pty": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
