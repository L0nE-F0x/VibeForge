{
  "name": "vibeforge",
  "version": "0.3.0",
  "private": true,
  "description": "VibeForge: a Linux desk for the coding CLIs already on this machine — agents, routines, tasks and real terminals.",
  "author": "Lone Fox (https://github.com/L0nE-F0x)",
  "license": "MIT",
  "homepage": "https://github.com/L0nE-F0x/VibeForge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L0nE-F0x/VibeForge.git"
  },
  "bugs": {
    "url": "https://github.com/L0nE-F0x/VibeForge/issues"
  },
  "keywords": [
    "omarchy",
    "hyprland",
    "arch-linux",
    "electron",
    "terminal",
    "claude-code",
    "codex",
    "grok",
    "ai-agents",
    "coding-agents"
